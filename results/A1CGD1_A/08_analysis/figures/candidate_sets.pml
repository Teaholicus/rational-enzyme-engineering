# Candidate sets for A1CGD1_A
# Generated by util_pymol_session.py -- edit freely, it is a starting point.

load N:/Jupiter_Projects/rational-enzyme-engineering/results/A1CGD1_A/00_binding_site/A1CGD1_A_with_AHR.pdb, target

# --- base presentation ---
hide everything
bg_color white
show cartoon, polymer
color grey80, polymer
set cartoon_transparency, 0.55
set ray_shadows, 0
set ray_opaque_background, 1
set antialias, 2
set stick_radius, 0.18
set label_size, 16
set label_color, black

# --- selections ---
select catalytic, chain A and resi 229+305
select seta_t1, chain A and resi 118+194+195+196+198+308
select seta_t2, chain A and resi 114+115+116+117+184+185+191+192+193+197+199+200+201+202+203+204+205+226+227+228+230+231+232+233+288+289+294+302+303+304+306+307
select setb_t1, chain A and resi 183+212+213+239+309+310
select setb_t2, chain A and resi 186+187+188+190+206+207+214+215+225+300+301
select ligand, not polymer and not solvent

# --- tier 2: context, thin lines ---
show lines, seta_t2 and not (name C+N+O)
color orange, seta_t2
set line_width, 2, seta_t2
show lines, setb_t2 and not (name C+N+O)
color purple, setb_t2
set line_width, 2, setb_t2

# --- tier 1: priority candidates, sticks + labels ---
show sticks, seta_t1 and not (name C+N+O)
color orange, seta_t1
label seta_t1 and name CA, "%s%s" % (one_letter[resn], resi)
show sticks, setb_t1 and not (name C+N+O)
color purple, setb_t1
label setb_t1 and name CA, "%s%s" % (one_letter[resn], resi)

# --- catalytic residues ---
show sticks, catalytic and not (name C+N+O)
color hotpink, catalytic
label catalytic and name CA, "%s%s" % (one_letter[resn], resi)

# --- ligand, if the structure has one ---
show sticks, ligand
color yellow, ligand
util.cnc('ligand')

# --- view ---
orient catalytic or seta_t1 or setb_t1
zoom catalytic or seta_t1 or setb_t1, 6
deselect

