# Candidate sets for A1CGD1_A -- sticks style
# Generated by util_pymol_session.py. A starting point; edit freely.

load N:/Jupiter_Projects/rational-enzyme-engineering/results/A1CGD1_A/00_binding_site/A1CGD1_A_with_AHR.pdb, target

# --- base presentation ---
hide everything
bg_color white
show cartoon, polymer
color grey40, polymer
set cartoon_transparency, 0
set ray_shadows, 0
set ray_opaque_background, 1
set antialias, 2
set stick_radius, 0.22
set label_size, 20
set label_color, black
set label_outline_color, black

# low-confidence / unmodelled stretch, hidden to unclutter the view
hide everything, chain A and resi 1-24

# --- selections ---
select catalytic, chain A and resi 229+305
select seta_t1, chain A and resi 118+194+195+196+198+308
select seta_t2, chain A and resi 114+115+116+117+184+185+191+192+193+197+199+200+201+202+203+204+205+226+227+228+230+231+232+233+288+289+294+302+303+304+306+307
select setb_t1, chain A and resi 183+212+213+239+309+310
select setb_t2, chain A and resi 186+187+188+190+206+207+214+215+225+300+301
select seta_all, seta_t1 or seta_t2
select setb_all, setb_t1 or setb_t2
select ligand, not polymer and not solvent

# --- colour: cartoon and side chains take the same solid colour, so a
#     residue does not read as two different shades ---
color orange, seta_all
color purple, setb_all
color red, catalytic

# --- tier 1 side chains, plus the catalytic residues ---
show sticks, (seta_t1 or setb_t1 or catalytic) and not (name C+N+O)
show sticks, ligand
color yellow, ligand

# --- labels (comment out if crowded) ---
label catalytic and name CA, "%s%s" % (resn, resi)

# --- view ---
orient catalytic or seta_t1 or setb_t1
zoom catalytic or seta_t1 or setb_t1, 8
deselect

# --- render (uncomment to write a file) ---
# ray 2400, 1800
# png A1CGD1_A_candidate_sets_sticks.png, dpi=300
